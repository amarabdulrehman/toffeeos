// TableOS — multi-tenant restaurant management SaaS
// See C:\Users\rpmmu\.claude\plans\build-prompt-for-claude-jiggly-origami.md for the design doc.
//
// Isolation strategy (two layers):
//  1. App layer: every tenant-scoped model below carries a plain `tenantId` column (denormalized
//     even onto line-item/child tables) so the Prisma Client Extension in src/server/db.ts can
//     inject `where: { tenantId }` on every query without needing relation joins.
//  2. DB layer: prisma/migrations/*_rls/migration.sql turns these same columns into Postgres RLS
//     policies with FORCE ROW LEVEL SECURITY, as defense in depth.
//
// All money fields are integer paisa (Int, 1/100 PKR). All percentage/tax-rate fields are integer
// basis points (1 bp = 0.01%, so 16.00% = 1600). See src/lib/money.ts and src/lib/pricing.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Platform (cross-tenant — only touched by signup, super-admin, and cron jobs)
// ============================================================================

model Plan {
  id                       String   @id @default(uuid())
  key                      String   @unique // "starter" | "growth" | "complete" — Phase D's tier gating keys off this directly
  name                     String
  /// Null means unlimited (the Complete plan) — previously a magic "999", made properly nullable
  /// when Phase D needed a real "unlimited" check rather than an arbitrary large number.
  maxBranches              Int?
  pricePaisaPerBranchMonth Int
  createdAt                DateTime @default(now())

  subscriptions Subscription[]
}

enum TenantStatus {
  TRIALING
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Tenant {
  id         String       @id @default(uuid())
  name       String
  slug       String       @unique
  status     TenantStatus @default(TRIALING)
  // Minimal per-tenant branding for the public online ordering site (Phase 4) — deliberately just
  // these two fields, not a full site builder.
  logoUrl    String?
  brandColor String? // hex, e.g. "#7c3aed"
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  branches             Branch[]
  users                User[]
  roles                Role[]
  memberships          Membership[]
  invites              Invite[]
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]
  customers            Customer[]
  categories           Category[]
  menuItems            MenuItem[]
  modifierGroups       ModifierGroup[]
  auditLogs            AuditLog[]
  orders               Order[]
  inventoryItems       InventoryItem[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Subscription {
  id                      String             @id @default(uuid())
  tenant                  Tenant             @relation(fields: [tenantId], references: [id])
  tenantId                String             @unique
  plan                    Plan               @relation(fields: [planId], references: [id])
  planId                  String
  status                  SubscriptionStatus @default(TRIALING)
  /// Snapshot of plan.maxBranches at subscription-create/tier-change time (null = unlimited) —
  /// kept as its own column rather than always reading through plan so a plan's limit can change
  /// later without silently reshaping every existing subscription that already opted into it.
  branchLimit             Int?               @default(1)
  /// The tenant's actual, current set of enabled gateable module keys (see GATEABLE_MODULES in
  /// src/lib/tiers.ts) — this, not `plan.key`, is what every permission gate now checks. Seeded
  /// from the plan's tier defaults at subscription-create time and reset to those defaults on every
  /// tier change, but freely toggleable per-module afterward from the platform admin panel without
  /// snapping back — plan/tier is only ever a *starting preset* for this column, never enforced
  /// directly. See src/server/platform.ts's setTenantFeatures / changeTenantTier.
  enabledModules          String[]           @default([])
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  paymentMethod           String? // "jazzcash" | "easypaisa" | "bank_transfer" | "stripe"
  /// Contracted recurring monthly price for THIS tenant, in paisa — overrides the
  /// plan.pricePaisaPerBranchMonth × activeBranches formula everywhere MRR/pricing is computed
  /// (see effectiveMonthlyRatePaisa in src/lib/billing.ts). Null = use the plan formula. Kept
  /// separate from any single SubscriptionPayment.amountPaisa on purpose: a payment is
  /// backward-looking ("what was collected, over an arbitrary period"), this is forward-looking
  /// ("what we bill monthly going forward") — a one-off discount or a 12-month prepayment must not
  /// silently distort the recurring figure.
  customMonthlyPricePaisa Int?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  payments SubscriptionPayment[]
}

/// Manual billing ledger. The platform admin collects payment out-of-band (bank transfer, cash,
/// JazzCash) and records it here; this table is the durable "what was actually paid, for what
/// period" record, while Subscription.currentPeriodEnd is the derived "paid through" pointer.
/// Rows are soft-voided, never deleted, so a mis-keyed amount stays auditable. Tenant-scoped and
/// RLS-protected like AuditLog even though only platformDb (BYPASSRLS) ever writes it today — this
/// keeps the door open for a tenant-facing billing-history view later without a schema/RLS retrofit.
model SubscriptionPayment {
  id             String       @id @default(uuid())
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  tenantId       String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId String

  /// Snapshot of plan.key at record time — a later tier change must not rewrite history.
  planKey     String
  /// Integer paisa, per the money convention (src/lib/money.ts). 0 is legal: a comped extension.
  amountPaisa Int
  periodStart DateTime
  periodEnd   DateTime
  /// Free label, same vocabulary as Subscription.paymentMethod — see PAYMENT_METHODS in
  /// src/lib/billing.ts: "cash" | "bank_transfer" | "jazzcash" | "easypaisa" | "card" | "other"
  method      String
  note        String?

  /// Denormalized platform actor, same pattern as AuditLog.actorId + metadata.platformUserEmail —
  /// PlatformUser lives outside RLS, so this table never joins to it directly.
  recordedById    String
  recordedByEmail String

  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  createdAt DateTime @default(now())

  @@index([tenantId, periodEnd])
  @@index([tenantId, createdAt])
}

model PlatformUser {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  name              String
  createdAt         DateTime @default(now())
  /// See User.sessionsValidFrom — same stateless-JWT revocation marker, for the platform admin.
  sessionsValidFrom DateTime @default(now())

  /// TOTP secret (base32), set once 2FA enrollment is confirmed — see src/server/platform-mfa.ts.
  /// Null/totpEnabled=false means this account has no second factor at all, which for the single
  /// most powerful account in the whole system (BYPASSRLS, every tenant) is a real gap worth
  /// closing given how few platform admin accounts typically exist.
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  /// Hashed (bcrypt, same as passwordHash) one-time recovery codes — losing the authenticator app
  /// with no recovery path would lock out the only platform admin account. Each is removed from
  /// the array the moment it's used.
  totpBackupCodes String[] @default([])
}

/// Persistent backing for src/server/auth/otp-store.ts's issueOtp/verifyOtp — was an in-memory Map
/// (per-process, doesn't survive a redeploy or work across multiple serverless instances), which is
/// exactly wrong for a login flow. Platform-level, no RLS: this is pre-session infrastructure state
/// (an OTP is issued before any tenant session exists), not tenant data.
model OtpCode {
  id        String   @id @default(uuid())
  /// Same key shape the old Map used, e.g. "{tenantId}:{phone}" — kept identical so the call sites
  /// in src/server/auth/otp-store.ts didn't need to change, only their internals.
  key       String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([key])
}

/// Persistent backing for src/server/auth/impersonation-store.ts. Same reasoning as OtpCode — a
/// platform admin's "Impersonate" click and the browser's next page load (which redeems the token)
/// can legitimately land on two different serverless instances.
model ImpersonationToken {
  token             String   @id
  tenantId          String
  targetUserId      String
  platformUserId    String
  platformUserEmail String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
}

/// Persistent backing for src/lib/rate-limit.ts's checkRateLimit. One row per hit rather than a
/// single counter, so the sliding-window semantics of the original in-memory implementation
/// (count hits strictly newer than now - windowMs) carry over exactly.
model RateLimitHit {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Backs the self-serve "forgot password" flow (src/server/password-reset.ts) for both tenant
/// staff and the platform admin — there was previously no recovery path for either. tenantId is
/// only set for userType "tenant": User.email isn't unique across tenants (by design — see the
/// signupTenant dedup check, which only applies to the self-serve trial funnel, not
/// admin-provisioned or invited accounts), so resolving *which* user a token belongs to needs the
/// tenant alongside the userId, not just the email that was originally entered.
model PasswordResetToken {
  token     String    @id @default(uuid())
  userType  String // "tenant" | "platform"
  userId    String
  tenantId  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userType, userId])
}

/// Append-only. tenantId is nullable to allow platform-wide entries (e.g. platform-user login)
/// that aren't about one tenant.
model AuditLog {
  id         String   @id @default(uuid())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  tenantId   String?
  branchId   String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ============================================================================
// Tenant core
// ============================================================================

model Branch {
  id        String   @id @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  name      String
  address   String?
  phone     String?
  timezone  String   @default("Asia/Karachi")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  settings        BranchSettings?
  taxRules        TaxRule[]
  memberships     Membership[]
  invites         Invite[]
  floors          Floor[]
  tables          RestaurantTable[]
  branchMenuItems BranchMenuItem[]
  orders          Order[]
  stockLocations  StockLocation[]

  @@index([tenantId])
}

enum RoundingMode {
  NONE
  NEAREST_1
  NEAREST_5
}

enum ThankYouTrigger {
  ON_ORDER
  ON_PAYMENT
}

model BranchSettings {
  id                            String       @id @default(uuid())
  branch                        Branch       @relation(fields: [branchId], references: [id])
  branchId                      String       @unique
  tenantId                      String
  currency                      String       @default("PKR")
  serviceChargeBasisPoints      Int          @default(0)
  serviceChargeAppliesTo        OrderType[]  @default([DINE_IN])
  serviceChargeTaxable          Boolean      @default(true)
  roundingMode                  RoundingMode @default(NEAREST_1)
  kdsSlaSeconds                 Int          @default(600)
  /// Off for a branch where the kitchen just works off a printed KOT at the counter (typical for
  /// a small cafe) and has no use for a dedicated Kitchen Display screen. Purely an operational
  /// preference the owner sets per branch — unrelated to subscription tier (unlike
  /// GATEABLE_MODULES), so a multi-branch tenant can have this on for one location and off for
  /// another. Doesn't touch the order lifecycle at all: sendToKitchen/kitchenReady/KOT printing
  /// all keep working exactly the same — this only hides the KDS nav link/dashboard tile and
  /// blocks the /kds route itself (see getBranchKdsEnabled in src/server/branch-settings.ts).
  kdsEnabled                    Boolean      @default(true)
  /// Free text printed under the branch name at the top of every receipt — address, phone, NTN
  /// number, "thank you" line. Line breaks are preserved as typed. Existed unused from Phase 1
  /// until the receipt branding work; null means nothing extra is printed.
  receiptHeader                 String?
  /// Print the tenant's logo at the top of the receipt. Per-branch, alongside receiptHeader, so a
  /// client running one branch that wants letterheaded receipts and another that does not is
  /// expressible — and defaults to false so no existing client's receipts change on deploy.
  showLogoOnReceipt             Boolean      @default(false)
  locale                        String       @default("en")
  /// Which StockLocation recipe consumption deducts from on order payment. Not a DB relation
  /// (deliberately soft) — src/server/recipes.ts falls back to the branch's oldest active
  /// location, or skips deduction entirely, if this is unset or points at a deleted location.
  defaultStockLocationId        String?
  /// Null = overtime is off (src/server/hr.ts's runPayroll/getPayslip treat every hour as regular
  /// pay, the original behavior). Only ever applies to HOURLY staff — a fixed monthly salary isn't
  /// affected by attendance at all, so overtime has no meaning there. Computed per ISO week within
  /// whatever date range payroll is run over, not per the range as a whole, since overtime law/
  /// practice is universally week-based, not tied to an arbitrary reporting window.
  overtimeThresholdHoursPerWeek Int?
  /// Basis points, same convention as every other rate in this schema (10000 = 1.00x). Only read
  /// when overtimeThresholdHoursPerWeek is set. Default 15000 = time-and-a-half.
  overtimeMultiplierBasisPoints Int          @default(15000)

  @@index([tenantId])
}

/// Rate depends on payment method (Punjab PRA: 16% cash / 8% card & digital). Empty
/// `paymentMethods` array = matches every method. See src/lib/pricing.ts effectiveRate().
model TaxRule {
  id              String          @id @default(uuid())
  branch          Branch          @relation(fields: [branchId], references: [id])
  branchId        String
  tenantId        String
  name            String
  paymentMethods  PaymentMethod[] @default([])
  rateBasisPoints Int
  effectiveFrom   DateTime        @default(now())
  effectiveTo     DateTime?
  isActive        Boolean         @default(true)

  @@index([branchId])
  @@index([tenantId])
}

model User {
  id                 String   @id @default(uuid())
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  tenantId           String
  email              String?
  phone              String?
  passwordHash       String?
  name               String
  /// Rider-specific (nullable, unused by other roles) — kept on the generic staff table rather
  /// than a separate Rider model since a rider is just a User with role "rider"; see
  /// src/server/permissions/registry.ts SEED_ROLES.rider.
  employeeId         String?
  isActive           Boolean  @default(true)
  /// Set true only when a platform admin generates the password (admin-provisioned tenant owner);
  /// self-serve signup and invite-accept both let the user pick their own password, so this stays
  /// false there. Checked at the app/pos/kds layout level, not in defineHandler, since it needs to
  /// gate page rendering before any API call happens.
  mustChangePassword Boolean  @default(false)
  /// Every session issued before this instant is rejected. Sessions are stateless JWTs, so there is
  /// no server-side record to delete on sign-out — bumping this is what actually revokes them.
  /// Signing out sets it to now(), which invalidates that JWT and any other copy of it (a cookie
  /// lifted from a shared POS terminal, a session left open on another device).
  sessionsValidFrom  DateTime @default(now())
  createdAt          DateTime @default(now())

  memberships   Membership[]
  staffPin      StaffPin?
  ordersCreated Order[]      @relation("OrderCreatedBy")
  ordersAsRider Order[]      @relation("OrderAssignedRider")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
}

/// Roles are per-tenant so owners can define their own; the 7 standard roles from the brief
/// are seeded with isSystem = true. `permissions` holds keys from
/// src/server/permissions/registry.ts.
model Role {
  id          String   @id @default(uuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  key         String
  name        String
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  memberships Membership[]
  invites     Invite[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// A user's assignment to one branch with one role, plus per-branch permission overrides.
/// Deny always wins over grant, and both win over the role's base permission set.
model Membership {
  id        String   @id @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  String
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String
  grants    String[] @default([])
  denies    String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Pay profile (Phase 4 Payroll & HR) — lives on the per-branch employment record, not User,
  // since pay rate is a property of "this person's job at this branch," not the person globally.
  // Null payType means "not set up for payroll yet" — runPayroll skips those rather than guessing.
  payType            PayType?
  hourlyRatePaisa    Int?
  monthlySalaryPaisa Int?

  @@unique([userId, branchId])
  @@index([tenantId, branchId])
}

enum PayType {
  HOURLY
  MONTHLY
}

model Invite {
  id         String    @id @default(uuid())
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String
  branch     Branch    @relation(fields: [branchId], references: [id])
  branchId   String
  role       Role      @relation(fields: [roleId], references: [id])
  roleId     String
  email      String?
  phone      String?
  token      String    @unique
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

/// PIN-based clock-in / quick switch at the POS. pinHash uses the same bcrypt hashing as
/// passwords; the raw PIN is never stored.
model StaffPin {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  tenantId  String
  pinHash   String
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ============================================================================
// Menu
// ============================================================================

model Category {
  id        String  @id @default(uuid())
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  tenantId  String
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  items MenuItem[]

  @@index([tenantId])
}

model MenuItem {
  id             String   @id @default(uuid())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  tenantId       String
  category       Category @relation(fields: [categoryId], references: [id])
  categoryId     String
  name           String
  description    String?
  imageUrl       String?
  basePricePaisa Int
  allergens      String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  variants        ItemVariant[]
  modifierGroups  MenuItemModifierGroup[]
  branchMenuItems BranchMenuItem[]
  recipeLines     RecipeLine[]

  @@index([tenantId, categoryId])
}

model ItemVariant {
  id              String   @id @default(uuid())
  tenantId        String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId      String
  name            String
  priceDeltaPaisa Int      @default(0)
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)

  @@index([menuItemId])
  @@index([tenantId])
}

model ModifierGroup {
  id        String @id @default(uuid())
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  tenantId  String
  name      String
  minSelect Int    @default(0)
  maxSelect Int    @default(1)

  modifiers Modifier[]
  menuItems MenuItemModifierGroup[]

  @@index([tenantId])
}

model Modifier {
  id              String        @id @default(uuid())
  tenantId        String
  group           ModifierGroup @relation(fields: [groupId], references: [id])
  groupId         String
  name            String
  priceDeltaPaisa Int           @default(0)
  sortOrder       Int           @default(0)

  @@index([groupId])
  @@index([tenantId])
}

model MenuItemModifierGroup {
  tenantId   String
  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id])
  menuItemId String
  group      ModifierGroup @relation(fields: [groupId], references: [id])
  groupId    String

  @@id([menuItemId, groupId])
  @@index([tenantId])
}

/// An item exists once centrally; each branch can hide it or override its price.
model BranchMenuItem {
  id                 String   @id @default(uuid())
  tenantId           String
  branch             Branch   @relation(fields: [branchId], references: [id])
  branchId           String
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId         String
  isAvailable        Boolean  @default(true)
  priceOverridePaisa Int?

  @@unique([branchId, menuItemId])
  @@index([tenantId])
}

// ============================================================================
// Floor & table (schema now, UI in Phase 2)
// ============================================================================

model Floor {
  id        String @id @default(uuid())
  tenantId  String
  branch    Branch @relation(fields: [branchId], references: [id])
  branchId  String
  name      String
  sortOrder Int    @default(0)

  tables RestaurantTable[]

  @@index([branchId])
  @@index([tenantId])
}

enum TableStatus {
  AVAILABLE
  RESERVED
  BOOKED
  OCCUPIED
}

model RestaurantTable {
  id       String      @id @default(uuid())
  tenantId String
  branch   Branch      @relation(fields: [branchId], references: [id])
  branchId String
  floor    Floor       @relation(fields: [floorId], references: [id])
  floorId  String
  label    String
  seats    Int         @default(4)
  status   TableStatus @default(AVAILABLE)
  posX     Int         @default(0)
  posY     Int         @default(0)

  orders Order[]

  @@unique([branchId, label])
  @@index([branchId, floorId])
  @@index([tenantId])
}

// ============================================================================
// Inventory (Phase 2 basics — recipe-based deduction against these arrives in Phase 3).
// InventoryItem is tenant-wide (mirrors Category/MenuItem); stock is tracked per-branch via
// StockLocation, so a multi-branch tenant sees one item master list but separate quantities per
// location. StockMovement is the append-only ledger (mirrors OrderEvent) that GRN/adjustment/
// transfer all write to; StockLevel is the derived current-quantity cache kept in sync alongside
// it in the same transaction — same "event log + derived cache" shape as Order/OrderEvent.
// ============================================================================

model StockLocation {
  id        String   @id @default(uuid())
  tenantId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockLevels    StockLevel[]
  movements      StockMovement[]
  lowStockAlerts LowStockAlert[]

  @@unique([branchId, name])
  @@index([tenantId])
}

model InventoryItem {
  id                   String   @id @default(uuid())
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  tenantId             String
  name                 String
  unitOfMeasure        String // free-text, e.g. "kg", "ltr", "pcs"
  lowStockThresholdQty Float    @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  stockLevels    StockLevel[]
  movements      StockMovement[]
  lowStockAlerts LowStockAlert[]
  recipeLines    RecipeLine[]

  @@index([tenantId])
}

/// Links a menu item to the inventory items it consumes per unit sold (e.g. "Chicken Karahi"
/// consumes 0.4kg chicken, 0.05kg tomato). Deliberately item-level only, not variant/modifier-level
/// — the fuller three-layer recipe system from the original brief is a later refinement once this
/// basic version is proven out. See src/server/recipes.ts for consumption + costing logic.
model RecipeLine {
  id              String        @id @default(uuid())
  tenantId        String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id])
  menuItemId      String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String
  quantityPerUnit Float
  createdAt       DateTime      @default(now())

  @@unique([menuItemId, inventoryItemId])
  @@index([tenantId])
  @@index([menuItemId])
}

/// Derived current-quantity cache: kept in sync with StockMovement inside the same transaction
/// (see src/server/inventory.ts) rather than recomputed by summing movements on every read.
model StockLevel {
  id         String        @id @default(uuid())
  tenantId   String
  location   StockLocation @relation(fields: [locationId], references: [id])
  locationId String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Float         @default(0)
  updatedAt  DateTime      @updatedAt

  @@unique([locationId, itemId])
  @@index([tenantId])
}

enum StockMovementType {
  GRN
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  RECIPE_CONSUMPTION
}

/// Append-only ledger. A transfer writes two rows (TRANSFER_OUT at the source, TRANSFER_IN at the
/// destination) sharing one transferGroupId so they can be displayed/audited as a single event.
model StockMovement {
  id              String            @id @default(uuid())
  tenantId        String
  branchId        String
  item            InventoryItem     @relation(fields: [itemId], references: [id])
  itemId          String
  location        StockLocation     @relation(fields: [locationId], references: [id])
  locationId      String
  type            StockMovementType
  quantityDelta   Float // positive for GRN/TRANSFER_IN, negative for ADJUSTMENT-down/TRANSFER_OUT
  costPaisa       Int? // GRN only
  supplierName    String? // GRN only, free-text — no Supplier module yet
  reason          String? // required by the API for ADJUSTMENT, enforced there not in the schema
  transferGroupId String?
  actorId         String?
  createdAt       DateTime          @default(now())

  @@index([tenantId, branchId, createdAt])
  @@index([itemId])
  @@index([transferGroupId])
}

enum LowStockAlertStatus {
  ACTIVE
  RESOLVED
}

/// The "queue" for low-stock notifications: written synchronously whenever a stock movement drops
/// an item below threshold (see src/server/inventory.ts), read by the dashboard badge now: a real
/// worker can drain ACTIVE rows to WhatsApp/email in Phase 4 without any schema change.
model LowStockAlert {
  id                 String              @id @default(uuid())
  tenantId           String
  branchId           String
  item               InventoryItem       @relation(fields: [itemId], references: [id])
  itemId             String
  location           StockLocation       @relation(fields: [locationId], references: [id])
  locationId         String
  quantityAtTrigger  Float
  thresholdAtTrigger Float
  status             LowStockAlertStatus @default(ACTIVE)
  createdAt          DateTime            @default(now())
  resolvedAt         DateTime?

  @@index([tenantId, branchId, status])
  @@index([itemId, locationId, status])
}

// ============================================================================
// Customers
// ============================================================================

model Customer {
  id             String   @id @default(uuid())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  tenantId       String
  name           String?
  phone          String?
  email          String?
  allergens      String[] @default([])
  loyaltyPoints  Int      @default(0)
  whatsappOptOut Boolean  @default(false)
  createdAt      DateTime @default(now())

  addresses CustomerAddress[]
  orders    Order[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model CustomerAddress {
  id         String   @id @default(uuid())
  tenantId   String
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  label      String?
  line1      String
  line2      String?
  city       String?
  lat        Float?
  lng        Float?

  @@index([customerId])
  @@index([tenantId])
}

// ============================================================================
// WhatsApp Business (Cloud API) — built against a dev-stub adapter (no live Meta
// credentials configured yet; see src/server/whatsapp/adapter.ts). Never mandatory: `enabled` and
// the per-message-type flags are per-tenant opt-in, and Customer.whatsappOptOut is per-customer.
// ============================================================================

model WhatsAppSettings {
  id                     String          @id @default(uuid())
  tenantId               String          @unique
  enabled                Boolean         @default(false)
  lowStockAlertsEnabled  Boolean         @default(true)
  dailySummaryEnabled    Boolean         @default(true)
  winBackEnabled         Boolean         @default(true)
  deliveryUpdatesEnabled Boolean         @default(true)
  /// "Thanks for dining with us at {restaurant}" — sent to the customer attached to a
  /// dine-in/takeaway/service order (never DELIVERY, which already gets its own pickup/delivered
  /// messages — a third message on top would be redundant, and "hope you loved it" reads oddly at
  /// the moment a delivery order is paid, often before the food is even made).
  thankYouEnabled        Boolean         @default(true)
  /// Per-restaurant choice of when that message actually fires — some want it the instant the
  /// order is punched, others only once it's actually paid for. Defaults to ON_PAYMENT, matching
  /// this feature's original behavior before the trigger became configurable.
  thankYouTrigger        ThankYouTrigger @default(ON_PAYMENT)
  businessPhoneNumberId  String? // Cloud API phone_number_id — unused until a real adapter replaces the stub
  businessAccountId      String? // Cloud API WhatsApp Business Account id — unused until a real adapter replaces the stub
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

/// Staff phone numbers that receive low-stock alerts and the daily summary for a branch — these
/// are internal notification targets, not customers, so they carry no opt-out (a manager who
/// doesn't want alerts is removed from the list, not "opted out" of their own job).
model WhatsAppRecipient {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  label     String
  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId, branchId])
}

enum WhatsAppTemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// WhatsApp requires a pre-approved template for any message sent outside a 24-hour
/// customer-initiated window — this models that real submission/approval lifecycle rather than
/// assuming free-text sending will work. sendWhatsApp() in src/server/whatsapp/send.ts refuses to
/// send against anything but an APPROVED template.
model WhatsAppTemplate {
  id              String                 @id @default(uuid())
  tenantId        String
  key             String // "low_stock_alert" | "daily_summary" | "win_back_30d" | "delivery_picked_up" | "delivery_delivered"
  name            String
  language        String                 @default("en")
  bodyText        String // Meta template syntax: {{1}}, {{2}}, ... placeholders
  status          WhatsAppTemplateStatus @default(DRAFT)
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([tenantId, key])
}

enum WhatsAppMessageStatus {
  SENT
  FAILED
  SKIPPED_DISABLED
  SKIPPED_OPTOUT
  SKIPPED_NO_TEMPLATE
}

/// Append-only send log — every attempt, sent or skipped, with the reason, so "did the win-back
/// batch actually go out" is answerable without checking Meta's dashboard.
model WhatsAppMessageLog {
  id           String                @id @default(uuid())
  tenantId     String
  branchId     String?
  customerId   String?
  toPhone      String
  templateKey  String
  renderedBody String?
  status       WhatsAppMessageStatus
  createdAt    DateTime              @default(now())

  @@index([tenantId, createdAt])
}

// ============================================================================
// Orders — Order.status is a derived cache; OrderEvent is the append-only source of truth
// used by offline replay (Phase 4), the KDS timeline, and the cancellation report.
// ============================================================================

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  SERVICE
}

enum OrderSource {
  POS
  ONLINE
  QR
}

enum OrderStatus {
  OPEN
  SENT_TO_KITCHEN
  READY
  SERVED
  PAID
  DELIVERED
  VOIDED
  CANCELLED
}

enum DeliveryProofMethod {
  PHOTO
  OTP
}

enum PaymentMethod {
  CASH
  CARD
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  OTHER
}

enum DiscountType {
  PERCENT
  FIXED
}

/// id is a client-generated ULID (not @default) so an offline POS tablet can mint the real
/// order ID before it ever reaches the server and replay it safely on reconnect. See ulid()
/// in src/lib/ids.ts. idempotencyKey guards against duplicate submission of the same order.
model Order {
  id             String @id
  idempotencyKey String
  tenant         Tenant @relation(fields: [tenantId], references: [id])
  tenantId       String
  branch         Branch @relation(fields: [branchId], references: [id])
  branchId       String

  table       RestaurantTable? @relation(fields: [tableId], references: [id])
  tableId     String?
  customer    Customer?        @relation(fields: [customerId], references: [id])
  customerId  String?
  createdBy   User?            @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdById String?

  orderNumber Int
  type        OrderType
  status      OrderStatus @default(OPEN)
  source      OrderSource @default(POS)

  // Delivery & rider (DELIVERY-type orders only). See src/server/delivery.ts. `deliveryOtpCode`
  // is a short-lived handoff code, not a security-critical secret — it exists purely so the
  // customer can verify the rider at the door, so it is stored in plain text like a receipt code.
  // `deliveryAddress` is a plain snapshot (not linked to CustomerAddress) — the same
  // "snapshot, don't reference mutable state" pattern as OrderLine.nameSnapshot. This was a real
  // gap: no DELIVERY order anywhere (POS or online) had anywhere to record an address until now.
  assignedRider       User?                @relation("OrderAssignedRider", fields: [assignedRiderId], references: [id])
  assignedRiderId     String?
  riderAssignedAt     DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  deliveryProofMethod DeliveryProofMethod?
  deliveryProofUrl    String?
  deliveryOtpCode     String?
  deliveryAddress     String?

  subtotalPaisa           Int @default(0)
  discountedSubtotalPaisa Int @default(0)
  serviceChargePaisa      Int @default(0)
  taxPaisa                Int @default(0)
  deliveryFeePaisa        Int @default(0)
  roundingAdjustmentPaisa Int @default(0)
  totalPaisa              Int @default(0)
  paidPaisa               Int @default(0)

  fiscalInvoiceNumber String?
  fiscalPushedAt      DateTime?

  sentToKitchenAt DateTime?
  readyAt         DateTime?
  servedAt        DateTime?
  paidAt          DateTime?
  voidedAt        DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Optimistic-concurrency counter for the offline sync engine (src/lib/offline). Bumped on every
  // state-changing action after creation (send-to-kitchen, pay, void). A queued offline action
  // carries the version it last saw; if the server's version has moved on by the time the action
  // replays, another device got there first — that's a genuine conflict, not something to
  // silently overwrite. See src/server/sync-conflicts.ts.
  version Int @default(1)

  lines     OrderLine[]
  discounts OrderDiscount[]
  payments  Payment[]
  events    OrderEvent[]

  @@unique([tenantId, idempotencyKey])
  @@unique([branchId, orderNumber])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, branchId, status])
  @@index([tenantId, assignedRiderId])
}

/// Records every client-generated actionId a mutating order action (send-to-kitchen, pay, void)
/// has already applied, so replaying an offline-queued action after a flaky reconnect — or the
/// client and server briefly disagreeing about whether a request landed — is a safe no-op instead
/// of double-applying. See withActionIdempotency in src/server/orders.ts.
model SyncActionLog {
  id         String   @id @default(uuid())
  tenantId   String
  actionId   String
  actionType String
  orderId    String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, actionId])
  @@index([tenantId, orderId])
}

enum SyncConflictKind {
  TABLE_DOUBLE_ORDER
  STALE_ORDER_ACTION
}

enum SyncConflictStatus {
  OPEN
  RESOLVED
}

/// A conflict the offline sync engine detected and refused to resolve automatically — e.g. two
/// devices both offline, both starting an order for the same table, or a queued pay/void replaying
/// against an order another device already changed. Surfaced to a manager (sync.conflict.resolve)
/// rather than silently picked with last-write-wins. See src/server/sync-conflicts.ts.
model SyncConflict {
  id                 String             @id @default(uuid())
  tenantId           String
  branchId           String
  kind               SyncConflictKind
  tableId            String?
  orderId            String?
  conflictingOrderId String?
  actionType         String?
  devicePayload      Json?
  serverSnapshot     Json?
  status             SyncConflictStatus @default(OPEN)
  resolutionNote     String?
  resolvedById       String?
  resolvedAt         DateTime?
  createdAt          DateTime           @default(now())

  @@index([tenantId, branchId, status])
}

/// id is a client-generated ULID for the same offline-replay reason as Order.id.
model OrderLine {
  id             String        @id
  tenantId       String
  order          Order         @relation(fields: [orderId], references: [id])
  orderId        String
  menuItemId     String
  variantId      String?
  nameSnapshot   String
  unitPricePaisa Int
  quantity       Int
  discountType   DiscountType?
  discountValue  Int?
  lineTotalPaisa Int
  isVoided       Boolean       @default(false)
  kitchenReady   Boolean       @default(false)
  notes          String?

  modifiers OrderLineModifier[]

  @@index([orderId])
  @@index([tenantId])
}

model OrderLineModifier {
  id              String    @id @default(uuid())
  tenantId        String
  orderLine       OrderLine @relation(fields: [orderLineId], references: [id])
  orderLineId     String
  modifierId      String
  nameSnapshot    String
  priceDeltaPaisa Int

  @@index([orderLineId])
  @@index([tenantId])
}

model OrderDiscount {
  id          String       @id @default(uuid())
  tenantId    String
  order       Order        @relation(fields: [orderId], references: [id])
  orderId     String
  type        DiscountType
  value       Int
  reason      String?
  appliedById String?

  @@index([orderId])
  @@index([tenantId])
}

/// One row per tender in a (possibly split) payment. taxRateBasisPoints records the rate
/// actually applied to this tender's apportioned slice — see effectiveRate() in pricing.ts.
model Payment {
  id                 String        @id @default(uuid())
  tenantId           String
  order              Order         @relation(fields: [orderId], references: [id])
  orderId            String
  method             PaymentMethod
  amountPaisa        Int
  tenderedPaisa      Int?
  changePaisa        Int?
  taxRateBasisPoints Int
  receivedById       String?
  createdAt          DateTime      @default(now())

  @@index([orderId])
  @@index([tenantId])
}

model OrderEvent {
  id        String   @id @default(uuid())
  tenantId  String
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  type      String
  payload   Json?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([tenantId])
}

// ============================================================================
// Payroll & HR (Phase 4). Payroll numbers are computed live from Shift/AttendanceRecord + a
// Membership's pay profile each time runPayroll() is called, not persisted as a "payroll run" —
// there's no history/audit trail of past runs, only of the attendance they're computed from. A
// deliberate scope decision for this phase, not an oversight.
// ============================================================================

/// A planned shift on the roster — separate from AttendanceRecord (what actually happened).
model Shift {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String
  userId      String
  startsAt    DateTime
  endsAt      DateTime
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, branchId, startsAt])
  @@index([tenantId, userId])
}

enum AttendanceSource {
  PIN
  MANUAL
}

/// clockInAt/clockOutAt, not a single timestamp + type, so "still clocked in" is just
/// clockOutAt = null rather than needing to pair up separate IN/OUT rows.
model AttendanceRecord {
  id         String           @id @default(uuid())
  tenantId   String
  branchId   String
  userId     String
  clockInAt  DateTime
  clockOutAt DateTime?
  source     AttendanceSource @default(PIN)
  editedById String? // set only when a manager corrected this record after the fact
  editNote   String?
  createdAt  DateTime         @default(now())

  @@index([tenantId, branchId, clockInAt])
  @@index([tenantId, userId])
}

/// Payroll itself is still computed live, never persisted (see the comment on runPayroll in
/// src/server/hr.ts) — this is the one thing that IS persisted: a record that a specific period's
/// pay was actually handed to a specific person, snapshotting the numbers at the moment it was
/// marked paid so a later change to their pay rate or a payroll-settings edit can't silently
/// rewrite history. No FK relation to Membership (same soft-reference convention as Shift/
/// AttendanceRecord above) — a membership can be deactivated or reassigned without orphaning the
/// record of what they were actually paid.
/// A cashier cancelling an order that's already been sent to the kitchen (Order.status ->
/// CANCELLED, distinct from a plain pre-kitchen VOIDED) always creates one of these, with a
/// mandatory reason — see cancelSentOrder in src/server/orders.ts. reviewedAt/reviewedById is the
/// manager/owner side of the loop: unreviewed rows are what the dashboard cancellation banner and
/// the Reports > Cancellations tab surface, so a kitchen-stage cancellation can't just happen
/// silently with nobody accountable for the wasted food/labor noticing it.
model OrderCancellation {
  id            String    @id @default(uuid())
  tenantId      String
  branchId      String
  orderId       String
  reason        String
  cancelledById String
  createdAt     DateTime  @default(now())
  reviewedById  String?
  reviewedAt    DateTime?

  @@index([tenantId, branchId, reviewedAt])
}

model PayrollDisbursement {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  membershipId  String
  periodStart   DateTime
  periodEnd     DateTime
  regularHours  Float
  overtimeHours Float    @default(0)
  grossPayPaisa Int
  method        String?
  note          String?
  paidById      String
  paidAt        DateTime @default(now())

  @@index([tenantId, branchId])
  @@index([tenantId, membershipId])
}

/// PENDING only ever happens if a role is granted finance.expense.create WITHOUT
/// finance.expense.approve — the two seeded roles that can record expenses (owner, branch_manager)
/// both hold approve, so in practice everything lands APPROVED today. The field exists from day one
/// so the review workflow those permissions imply can be built later without a migration. The rule
/// that matters for reporting: PENDING never counts toward any total.
enum ExpenseStatus {
  PENDING
  APPROVED
}

/// Tenant-defined expense buckets (Rent, Utilities, ...). Seeded with sensible defaults at signup
/// (see provisionTenant in src/server/tenant-signup.ts) but fully editable afterward — every
/// restaurant's cost lines differ. Archived via isActive rather than deleted, same as InventoryItem:
/// a category that's been retired must keep resolving for the historical expenses pointing at it.
/// Deliberately NOT unique on (tenantId, name) — InventoryItem isn't either, and a unique index
/// would make archive-then-recreate of the same name fail in a way nobody would understand.
model ExpenseCategory {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

/// A single cost the business actually incurred. `spentAt` is the date the money went out and is
/// what every filter and report uses — never `createdAt`, so entering January's rent in February
/// still lands in January. `recurringExpenseId` is set only on rows generated from a
/// RecurringExpense template, which is what keeps that generation idempotent.
model Expense {
  id                 String         @id @default(uuid())
  tenantId           String
  branchId           String
  categoryId         String
  spentAt            DateTime
  amountPaisa        Int
  vendorName         String? // free text — no Supplier module (same convention as StockMovement.supplierName)
  method             PaymentMethod?
  note               String?
  status             ExpenseStatus  @default(APPROVED)
  recordedById       String
  approvedById       String?
  approvedAt         DateTime?
  recurringExpenseId String?
  createdAt          DateTime       @default(now())

  @@index([tenantId, branchId, spentAt])
  @@index([tenantId, categoryId])
  @@index([recurringExpenseId, spentAt])
}

/// A fixed monthly cost (rent, utilities, a service contract) that should appear every month without
/// anyone re-typing it. Materialised into real Expense rows by materialiseRecurringExpenses in
/// src/server/expenses.ts, called from the existing daily cron rather than a new one.
/// `dayOfMonth` is constrained to 1-28 at the API layer: every month has those days, which sidesteps
/// "what does the 31st mean in February" entirely instead of hiding clamping logic somewhere.
/// `lastGeneratedFor` holds the spentAt of the most recent generated row and is the idempotency
/// guard — generation catches up from there, so a paused cron backfills instead of losing months.
model RecurringExpense {
  id               String         @id @default(uuid())
  tenantId         String
  branchId         String
  categoryId       String
  amountPaisa      Int
  vendorName       String?
  method           PaymentMethod?
  note             String?
  dayOfMonth       Int
  isActive         Boolean        @default(true)
  startsOn         DateTime
  endsOn           DateTime?
  lastGeneratedFor DateTime?
  createdById      String
  createdAt        DateTime       @default(now())

  @@index([tenantId, branchId, isActive])
}

/// One cash drawer per branch per business day: the float it started with, and what was actually
/// counted at close. The two POS permissions this uses (pos.shift.open / pos.shift.close) were
/// declared in the original design and left unbuilt until now, same as the finance.* ones were.
///
/// `businessDate` is a plain "YYYY-MM-DD" string, not a date/timestamp column, and that is
/// deliberate. A restaurant's day is a wall-clock day in the branch's own timezone (Branch.timezone
/// — a branch closing at 2am belongs to the previous business day), which a UTC instant cannot
/// express without ambiguity. It also sidesteps the `timestamp without time zone` trap that has
/// already produced two silent bugs here (Expense.spentAt, User.sessionsValidFrom): a string means
/// the same day no matter which driver reads it.
///
/// The expected closing balance is never stored — it is derived on read from opening + cash taken
/// - cash spent. Storing it would let it drift the moment a late payment or expense lands on a day
/// already closed, and a stale expectation is worse than none: the variance is the whole point.
model CashDrawerDay {
  id                  String    @id @default(uuid())
  tenantId            String
  branchId            String
  businessDate        String // "YYYY-MM-DD" in the branch's timezone — see the note above
  openingBalancePaisa Int
  openedById          String
  openedAt            DateTime  @default(now())
  /// What a human counted in the drawer at close. Null while the day is still open.
  closingCountedPaisa Int?
  closedById          String?
  closedAt            DateTime?
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  /// One drawer per branch per day — this is what makes "open the day" idempotent and stops two
  /// cashiers opening the same morning twice with different floats.
  @@unique([branchId, businessDate])
  @@index([tenantId, branchId, businessDate])
}
