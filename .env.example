# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.
#
# ---- Database (Supabase Postgres) ----
# DATABASE_URL: the pooled connection (Supabase "Transaction pooler", port 6543, ?pgbouncer=true),
#   authenticated as the restricted `app_user` role created by prisma/migrations/*_rls/migration.sql.
#   This is what the running app uses for every query (src/server/db.ts).
# DIRECT_URL: the unpooled connection (Supabase "Direct connection", port 5432), authenticated as
#   the Postgres owner/postgres role. Used only by `prisma migrate` (prisma.config.ts).
DATABASE_URL="postgresql://app_user:CHANGE_ME@db.PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:CHANGE_ME@db.PROJECT_REF.supabase.co:5432/postgres"
# PLATFORM_DATABASE_URL: separate connection, `platform_user` role (BYPASSRLS), used only by the
#   (platform) super-admin route handlers — see prisma/migrations/*_rls_and_roles/migration.sql.
PLATFORM_DATABASE_URL="postgresql://platform_user:CHANGE_ME@db.PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true"

# ---- Supabase (Realtime + Storage) ----
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="CHANGE_ME"
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME"

# ---- Auth.js ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="CHANGE_ME"
AUTH_URL="http://localhost:3000"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Scheduled jobs ----
# Shared secret an external scheduler (Vercel Cron, cron-job.org, etc.) sends as
# `Authorization: Bearer <secret>` to hit /api/cron/*. Optional in dev — those routes just reject
# every request if this is unset, rather than running unauthenticated.
CRON_SECRET="CHANGE_ME"

# ---- Error monitoring (Sentry) ----
# All optional — the SDK is a safe no-op with no DSN set, and only ever active when
# NODE_ENV=production regardless (see sentry.server.config.ts / sentry.edge.config.ts). Create a
# free Sentry project and fill these in before going live.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to enable source-map upload at build time — safe to leave unset.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ---- Transactional email (Resend) ----
# Both optional — src/server/email/adapter.ts falls back to a console.log dev-stub with either one
# unset, same "safe either way" pattern as Sentry above. Only caller today is password reset. Get
# an API key at resend.com and a "from" address on a domain you've verified with them.
RESEND_API_KEY=""
EMAIL_FROM=""

# ---- Seed & E2E credentials ----
# No defaults on purpose. These were once hardcoded in prisma/seed.ts as "Passw0rd!" and
# "ChangeMe123!"; because dev, test and production share one database, that made the seeded demo
# accounts — the tenant *owner* among them — openable on the live public site by anyone who read the
# repo. prisma/seed.ts and e2e/fixtures/test-data.ts now both throw if these are unset rather than
# falling back, since a fallback would silently restore exactly that.
# Generate strong values and keep them in .env only (gitignored):
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
DEMO_SEED_PASSWORD=""
PLATFORM_SEED_PASSWORD=""
# Optional — defaults to 1234. Only the staff quick-login PIN on the demo tenant.
DEMO_SEED_PIN=""
